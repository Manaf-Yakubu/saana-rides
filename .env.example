# --- API ---
NODE_ENV=development
API_PORT=4000
DATABASE_URL=postgresql://saana:saana@localhost:5432/saana?schema=public
REDIS_URL=redis://localhost:6379
# Dev-only placeholders; production refuses to start with them.
# Generate real values with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0000000000
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# 32-byte base64 key for AES-256-GCM field encryption (all-zero dev key; production rejects it).
# Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
RATE_LIMIT_PER_MINUTE=120
MFA_ISSUER=SAANA RIDES
CORS_ORIGINS=http://localhost:3000
# S3-compatible storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=saana-documents
S3_ACCESS_KEY_ID=saana
S3_SECRET_ACCESS_KEY=saana-secret
SENTRY_DSN=
# --- WEB ---
NEXT_PUBLIC_API_URL=http://localhost:4000
