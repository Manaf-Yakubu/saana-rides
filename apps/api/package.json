{
  "name": "@saana/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:int": "jest --config test/jest-int.json --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "cli:create-admin": "node dist/cli/create-admin.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.6",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@prisma/client": "5.22.0",
    "@saana/shared": "workspace:*",
    "argon2": "0.45.1",
    "helmet": "8.3.0",
    "nestjs-pino": "4.6.1",
    "otplib": "12.0.1",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.6",
    "@saana/config": "workspace:*",
    "@testcontainers/postgresql": "10.13.2",
    "@types/express": "5.0.0",
    "@types/jest": "29.5.14",
    "@types/node": "20.16.11",
    "@types/supertest": "6.0.2",
    "eslint": "9.39.5",
    "jest": "29.7.0",
    "pino-pretty": "11.3.0",
    "prisma": "5.22.0",
    "supertest": "7.0.0",
    "testcontainers": "10.13.2",
    "ts-jest": "29.2.5",
    "typescript": "5.6.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "coverageDirectory": "../coverage"
  }
}
